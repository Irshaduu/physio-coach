# ==============================================================================
# PhysioCoach — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to git.
# ==============================================================================

# Django secret key. Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production. True enables the debug error page.
DEBUG=True

# Comma-separated list of allowed hosts. Example:
#   ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1
